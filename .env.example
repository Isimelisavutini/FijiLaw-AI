# Web
NEXT_PUBLIC_API_URL=http://localhost:5000
PUBLIC_WEB_URL=http://localhost:3000

# Verified member identity (Clerk)
# Production configuration must enable Google, Apple, email verification codes,
# and phone verification. Enable Fiji (+679) on the SMS country allowlist.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
AUTH_BRIDGE_SECRET=

# Allowed browser origins for API CORS
WebOrigin=http://localhost:3000
AllowedWebOrigins=

# AI provider (server-side only)
# Create a project API key in the OpenAI Platform and never expose it through NEXT_PUBLIC_* variables.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# PostgreSQL / pgvector
DATABASE_URL=

# Transactional email (server-side only)
# EMAIL_FROM must use a verified Resend sending domain before production email will work.
RESEND_API_KEY=
EMAIL_FROM=FijiLaw AI <verify@example.com>

# Admin API
ADMIN_API_KEY=

# Azure Storage (optional during local MVP)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=legal-documents

# Azure AI Search (optional)
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_API_KEY=
AZURE_SEARCH_INDEX=fiji-law
